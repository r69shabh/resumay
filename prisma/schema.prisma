generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Resume {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String   @default("Untitled resume")
  roleTag     String   @default("")
  latexSource String
  content     Json?
  customLatex Boolean  @default(false)
  // Neon Auth user id. Plain scalar — identity lives in Neon's managed
  // neon_auth schema, not in our tables.
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
