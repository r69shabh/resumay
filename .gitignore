# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# sqlite dev databases
*.db
*.db-journal

# downloaded tectonic binary (fetch-tectonic.mjs recreates it on deploy builds)
/bin/

# copied pdf.js worker (setup-assets.mjs recreates it)
public/pdf.worker.mjs

# vercel
.vercel

# agent skill syncs (regenerated by `prisma skills sync` on install)
.agents/
.claude/
.cursor/
.devin/

# typescript
*.tsbuildinfo
next-env.d.ts
.neon
